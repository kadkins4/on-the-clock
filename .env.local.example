# Alpha suggestion box → Formspree. Copy this file to .env.local and fill in.
# Unset: suggestions are stashed in localStorage under "otc:suggestions".
# Create a form at https://formspree.io and paste its endpoint URL here.
VITE_FORMSPREE_ENDPOINT=

# Yahoo ADP source (optional). Register a Confidential Client app at
# https://developer.yahoo.com/apps/ (redirect https://localhost:8080, Fantasy
# Sports → Read), then run `npm run yahoo-auth` to fill these in automatically.
# See scripts/adp/README.md.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REFRESH_TOKEN=

# TV-mode draft announcer (optional). Create a free key at
# https://elevenlabs.io — Profile → API Keys. UNPREFIXED so it stays
# server-side; the browser only ever talks to /api/tts.
# Unset: the announcer falls back to the browser's built-in speechSynthesis
# voice, which is free and offline. That is the intended production default —
# do NOT set this in Vercel unless you want visitors spending your credits.
# Free tier is ~10k credits/month at 1 character = 1 credit, and is
# non-commercial use only.
ELEVENLABS_API_KEY=
# Optional stock-voice override; defaults to a built-in voice.
ELEVENLABS_VOICE_ID=
